				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Server.Main: cria os remotes, inicia os servicos na ordem certa e faz as ligacoes entre agentes.
-- Dono: lider.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)

local Services = script.Parent.Services
local DataService = require(Services.DataService)
local StatService = require(Services.StatService)
local InventoryService = require(Services.InventoryService)
local UpgradeService = require(Services.UpgradeService)
local TalentService = require(Services.TalentService)
local ArtifactService = require(Services.ArtifactService)
local ResetService = require(Services.ResetService)
local EnemyService = require(Services.EnemyService)
local AuraService = require(Services.AuraService)
local ElementService = require(Services.ElementService)

-- Ordem: dados -> progressao -> gameplay
local ordered: { Types.Service } = {
	DataService,
	StatService,
	InventoryService,
	UpgradeService,
	TalentService,
	ArtifactService,
	ResetService,
	EnemyService,
	AuraService,
	ElementService,
}

Remotes.Init()

for _, service in ordered do
	service.Init()
end

-- Ligacoes entre agentes (registradas antes do Start para nao perder eventos)
DataService.OnPlayerReady(function(player: Player)
	StatService.Refresh(player)
end)

EnemyService.OnEnemyKilled(function(killer: Player, enemyType: Types.EnemyType, position: Vector3)
	InventoryService.GrantKillDrop(killer, enemyType, position)
	ArtifactService.RollOnKill(killer)
end)

for _, service in ordered do
	service.Start()
end

print("[Server] servicos iniciados")
]]></ProtectedString>
