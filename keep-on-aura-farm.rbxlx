			<Item class="ModuleScript" referent="RBX1BE6CA5C60D94490B85BE47C4F70505B">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Remotes: nomes, direcao e payload de todos os remotes (parte do CONTRATO).
-- Dono: lider. O servidor cria as instancias (Remotes.Init, chamado pelo Server.Main).
-- Use sempre Remotes.Names.X, nunca strings soltas.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

Remotes.Names = {
	-- Servidor -> Cliente (RemoteEvent, FireClient)
	StateUpdated = "StateUpdated", -- (snapshot: Types.ClientSnapshot)
	DamageDealt = "DamageDealt", -- (payload: Types.DamageDealtPayload) so para quem causou o dano
	ItemsDropped = "ItemsDropped", -- (payload: Types.ItemsDroppedPayload) so para quem matou
	ArtifactObtained = "ArtifactObtained", -- (payload: Types.ArtifactObtainedPayload)

	-- Cliente -> Servidor (RemoteFunction, InvokeServer). O servidor valida tudo.
	RequestState = "RequestState", -- () -> Types.ClientSnapshot? (nil se os dados ainda nao carregaram)
	PurchaseUpgrade = "PurchaseUpgrade", -- (upgradeId: string) -> Types.ActionResult
	RequestReset = "RequestReset", -- () -> Types.ResetOffer
	ChooseTalent = "ChooseTalent", -- (talentId: string) -> Types.ActionResult (confirma o reinicio)
}

local EVENTS = { "StateUpdated", "DamageDealt", "ItemsDropped", "ArtifactObtained" }
local FUNCTIONS = { "RequestState", "PurchaseUpgrade", "RequestReset", "ChooseTalent" }

local FOLDER_NAME = "RemoteEvents"

local function getFolder(): Instance
	if RunService:IsServer() then
		local folder = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = FOLDER_NAME
			folder.Parent = ReplicatedStorage
		end
		return folder :: Instance
	end
	return ReplicatedStorage:WaitForChild(FOLDER_NAME)
end

-- So no servidor, uma vez, antes de iniciar os servicos.
function Remotes.Init(): ()
	assert(RunService:IsServer(), "Remotes.Init so roda no servidor")
	local folder = getFolder()
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	for _, name in FUNCTIONS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = folder
		end
	end
end

-- No cliente espera o remote existir; no servidor exige que Remotes.Init ja tenha rodado.
local function get(name: string): Instance
	local folder = getFolder()
	if RunService:IsServer() then
		local remote = folder:FindFirstChild(name)
		assert(remote, "Remote nao existe (Remotes.Init rodou?): " .. name)
		return remote :: Instance
	end
	return folder:WaitForChild(name)
end

function Remotes.Event(name: string): RemoteEvent
	local remote = get(name)
	assert(remote:IsA("RemoteEvent"), "Nao e RemoteEvent: " .. name)
	return remote :: RemoteEvent
end

function Remotes.Function(name: string): RemoteFunction
	local remote = get(name)
	assert(remote:IsA("RemoteFunction"), "Nao e RemoteFunction: " .. name)
	return remote :: RemoteFunction
end

return Remotes
]]></ProtectedString>
