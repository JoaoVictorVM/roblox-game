				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- Types: tipos compartilhados entre servidor e cliente (parte do CONTRATO).
-- Dono: lider. Mudancas so via docs/CONTRACT_REQUESTS.md.
-- Ids (itens, upgrades, talentos, artefatos) vem do Config; aqui so documentamos os formatos.

-- "SlimeBall" | "ZombieFlesh" | "SkeletonBone" (Config.Items)
export type ItemId = string
-- "Slime" | "Zombie" | "Skeleton" (chaves de Config.Enemies)
export type EnemyType = string
-- "AuraSize" | "TickSpeed" | "ExtraDrop" | "Fire" | "Lightning" | "Ice" | "Speed"
export type UpgradeId = string
-- Config.Talents.Pool[i].Id / Config.Artifacts.Pool[i].Id
export type TalentId = string
export type ArtifactId = string
-- Config.Talents/Artifacts .Stat: "AuraRadius" | "AuraDamage" | "DropAmount" | "EnemyCount" | "ElementDamage"
-- | "FireDamage" | "LightningDamage" | "IceDamage" | "MoveSpeed" | "RespawnTime" | "UpgradeCost" | "ArtifactChance"
export type StatId = string

export type DamageSource = "Aura" | "Fire" | "Lightning" | "Ice"

-- Quantidade por item, ex.: { SlimeBall = 10, SkeletonBone = 5 }
export type ItemCounts = { [ItemId]: number }

----------------------------------------------------------------
-- ESTADO DO JOGADOR (servidor, em memoria)
----------------------------------------------------------------

-- Run atual: NAO e salva. Zera no reinicio.
export type RunState = {
	Items: ItemCounts, -- todos os itens de Config.Items, comecando em 0
	Upgrades: { [UpgradeId]: number }, -- nivel comprado por upgrade (0 = nao comprado)
}

-- Progresso permanente: e o que vai para o DataStore.
export type PersistentData = {
	Version: number, -- versao do formato (comeca em 1)
	ResetCount: number, -- reinicios ja feitos
	Talents: { [TalentId]: number }, -- quantas vezes cada talento foi escolhido (acumula)
	Artifacts: { [ArtifactId]: boolean }, -- artefatos obtidos (conjunto)
}

export type PlayerState = {
	Run: RunState,
	Persistent: PersistentData,
	PendingTalentOptions: { TalentId }?, -- opcoes oferecidas no RequestReset, aguardando ChooseTalent
	CanSave: boolean, -- false se o load do DataStore falhou (evita sobrescrever dados bons)
}

-- Valores finais ja com upgrades + bonus (calculados pelo StatService a partir do Config).
export type PlayerStats = {
	AuraRadius: number, -- studs
	AuraDamage: number, -- dano por tick
	TickInterval: number, -- segundos
	DropMultiplier: number, -- parte inteira garantida, fracao = chance de +1
	WalkSpeed: number, -- ja limitado a Config.Speed.MaxWalkSpeed

	FireLevel: number, -- 0 = desligado
	FireDps: number,
	LightningLevel: number,
	LightningDamage: number,
	LightningBolts: number,
	LightningRange: number, -- AuraRadius * Config.Upgrades.Lightning.RadiusMultiplier
	IceLevel: number,
	IceDamage: number,
	IceTargets: number,

	EnemyCountMultiplier: number, -- 1 + bonus EnemyCount
	RespawnTimeMultiplier: number, -- 1 + bonus RespawnTime (bonus negativo)
	ArtifactChance: number, -- chance final por kill (0..1)
	CostMultiplier: number, -- Config.CostMultiplier(bonus UpgradeCost), piso 0.5
}

----------------------------------------------------------------
-- PAYLOADS DE REDE (ver Shared.Remotes)
----------------------------------------------------------------

-- Tudo o que a UI precisa para se desenhar. Enviado inteiro a cada mudanca.
export type ClientSnapshot = {
	Items: ItemCounts,
	Upgrades: { [UpgradeId]: number },
	UpgradeCosts: { [UpgradeId]: ItemCounts }, -- custo do PROXIMO nivel ja com desconto; ausente = nivel maximo
	Talents: { [TalentId]: number },
	Artifacts: { [ArtifactId]: boolean },
	ResetCount: number,
	ResetRequirement: ItemCounts, -- requisito do proximo reinicio
	Stats: PlayerStats,
}

-- Resposta padrao de pedidos cliente -> servidor.
export type ActionResult = {
	Ok: boolean,
	Reason: string?, -- mensagem curta em portugues quando Ok = false
}

-- Resposta do RequestReset: se Ok, traz as opcoes de talento para escolher.
export type ResetOffer = {
	Ok: boolean,
	Reason: string?,
	Options: { TalentId }?,
}

export type DamageDealtPayload = {
	EnemyId: number,
	Position: Vector3, -- posicao do inimigo atingido
	Amount: number,
	Source: DamageSource,
	Killed: boolean,
}

export type ItemsDroppedPayload = {
	Items: ItemCounts, -- so os itens que cairam neste kill
	Position: Vector3,
}

export type ArtifactObtainedPayload = {
	ArtifactId: ArtifactId,
}

----------------------------------------------------------------
-- INIMIGOS (servidor)
----------------------------------------------------------------

-- Visao publica de um inimigo vivo (EnemyService).
export type Enemy = {
	Id: number,
	Type: EnemyType,
	Model: Model,
	Position: Vector3,
	Health: number,
	MaxHealth: number,
}

----------------------------------------------------------------
-- MODULOS
----------------------------------------------------------------

-- Todo servico do servidor segue este ciclo: Init (sem chamar outros servicos), depois Start.
export type Service = {
	Init: () -> (),
	Start: () -> (),
}

-- Todo modulo de UI do cliente: Init cria a interface; Update redesenha com o snapshot.
export type UIModule = {
	Init: () -> (),
	Update: (snapshot: ClientSnapshot) -> (),
}

return {}
]]></ProtectedString>
					<string name="ScriptGuid">{992F4FAB-591D-41D2-B7DD-4F5775D51DB7}</string>
