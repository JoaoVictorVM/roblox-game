				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	KEEP ON AURA FARM - Config do MVP
	ModuleScript (sugestao: ReplicatedStorage/Config)
	Todos os numeros sao PROVISORIOS: ajuste apos playtest.
]]

local Config = {}

local function round(x)
	return math.floor(x + 0.5)
end

----------------------------------------------------------------
-- ITENS
----------------------------------------------------------------
Config.Items = { "SlimeBall", "ZombieFlesh", "SkeletonBone" }

----------------------------------------------------------------
-- AURA (valores base, antes de upgrades)
----------------------------------------------------------------
Config.Aura = {
	BaseRadius = 8,          -- studs
	BaseDamage = 10,         -- dano por tick
	BaseTickInterval = 1.0,  -- segundos
}

----------------------------------------------------------------
-- INIMIGOS (parados, sem regeneracao de vida)
----------------------------------------------------------------
Config.Enemies = {
	Slime = {
		MaxHealth = 30,
		Drop = "SlimeBall",
		DropAmount = 1,
		MaxAlive = 12,
		RespawnTime = 8,   -- segundos
	},
	Zombie = {
		MaxHealth = 80,
		Drop = "ZombieFlesh",
		DropAmount = 1,
		MaxAlive = 8,
		RespawnTime = 12,
	},
	Skeleton = {
		MaxHealth = 150,
		Drop = "SkeletonBone",
		DropAmount = 1,
		MaxAlive = 6,
		RespawnTime = 14,
	},
}

Config.Spawn = {
	AreaSize = 150,               -- mapa quadrado 150x150 studs, centrado na origem
	MinDistanceFromPlayer = 15,   -- nao nasce em cima do jogador
	MinDistanceBetweenEnemies = 6,
	RegenHealth = false,          -- inimigo mantem a vida se voce sair da aura
}

----------------------------------------------------------------
-- UPGRADES BASICOS (5 niveis)
-- Custo no nivel n = round(BaseCost * CostGrowth ^ (n - 1))
----------------------------------------------------------------
Config.Upgrades = {
	AuraSize = {
		Name = "Tamanho da Aura",
		MaxLevel = 5,
		BaseCost = { SlimeBall = 10 },
		CostGrowth = 2.4,
		ValueGrowth = 1.2,   -- raio = BaseRadius * 1.2 ^ nivel
	},
	TickSpeed = {
		Name = "Velocidade do Tick",
		MaxLevel = 5,
		BaseCost = { ZombieFlesh = 8 },
		CostGrowth = 2.4,
		ValueGrowth = 0.85,  -- intervalo = BaseTickInterval * 0.85 ^ nivel
	},
	ExtraDrop = {
		Name = "Drop Extra",
		MaxLevel = 5,
		BaseCost = { SkeletonBone = 6 },
		CostGrowth = 2.4,
		ValueGrowth = 1.25,  -- multiplicador = 1.25 ^ nivel (parte inteira garantida, fracao = chance)
	},

	-- UPGRADES DE ELEMENTO (5 niveis, 2 materiais cada)
	Fire = {
		Name = "Chao em Chamas",
		MaxLevel = 5,
		BaseCost = { SlimeBall = 12, SkeletonBone = 5 },
		CostGrowth = 2.4,
		BurnDuration = 4,                        -- segundos apos sair da area
		BurnDps = { 2.0, 3.0, 4.5, 6.8, 10.1 },  -- dano por segundo da queimadura
		-- Area do fogo = raio da aura. Reaplicar renova a duracao (nao acumula).
	},
	Lightning = {
		Name = "Raios",
		MaxLevel = 5,
		BaseCost = { ZombieFlesh = 10, SkeletonBone = 5 },
		CostGrowth = 2.4,
		Interval = 3,                            -- segundos entre raios
		RadiusMultiplier = 1.3,                  -- alcance = raio da aura * 1.3
		Damage = { 15, 20, 27, 37, 50 },
		Bolts = { 1, 1, 1, 2, 2 },               -- raios por vez (inimigos aleatorios)
	},
	Ice = {
		Name = "Espinhos de Gelo",
		MaxLevel = 5,
		BaseCost = { SlimeBall = 12, ZombieFlesh = 10 },
		CostGrowth = 2.4,
		Interval = 1,                            -- segundos
		OnlyWhileMoving = true,                  -- so ativa com o personagem andando
		Damage = { 6, 8, 11, 15, 20 },
		Targets = { 1, 1, 2, 2, 3 },
	},
}

----------------------------------------------------------------
-- VELOCIDADE DO PERSONAGEM (infinito, 3 materiais)
----------------------------------------------------------------
Config.Speed = {
	Name = "Velocidade do Personagem",
	BaseWalkSpeed = 16,       -- padrao do Roblox
	PerLevel = 0.05,          -- +5% da base por nivel
	MaxWalkSpeed = 80,        -- teto de seguranca (evita bugs de fisica)
	BaseCost = { SlimeBall = 15, ZombieFlesh = 10, SkeletonBone = 8 },
	CostGrowth = 1.9,
}

----------------------------------------------------------------
-- REINICIO (PRESTIGIO)
-- Exige TODOS os itens ao mesmo tempo. Cada reinicio multiplica o requisito.
-- Reseta: itens e upgrades. Mantem: talentos, artefatos, contador de reinicios.
----------------------------------------------------------------
Config.Reset = {
	BaseRequirement = { SlimeBall = 1000, ZombieFlesh = 600, SkeletonBone = 300 },
	Growth = 1.8,         -- reinicio 1: 1000/600/300, reinicio 2: 1800/1080/540, ...
	ConsumeItems = true,  -- itens sao gastos ao reiniciar (como a bigorna do original)
}

----------------------------------------------------------------
-- TALENTOS (permanentes, escolha 1 entre 3 sorteados a cada reinicio)
-- Podem se repetir e se acumulam. Bonus de % somam entre si.
----------------------------------------------------------------
Config.Talents = {
	OptionsPerChoice = 3,
	Pool = {
		{ Id = "SharpAura",   Name = "Aura Afiada",    Stat = "AuraDamage",     Value = 0.25, Desc = "+25% de dano do tick" },
		{ Id = "WideAura",    Name = "Aura Ampla",     Stat = "AuraRadius",     Value = 0.10, Desc = "+10% de raio da aura" },
		{ Id = "Looter",      Name = "Saqueador",      Stat = "DropAmount",     Value = 0.15, Desc = "+15% de drops" },
		{ Id = "Crowd",       Name = "Multidao",       Stat = "EnemyCount",     Value = 0.15, Desc = "+15% de inimigos no mapa" },
		{ Id = "Elementalist",Name = "Elementalista",  Stat = "ElementDamage",  Value = 0.30, Desc = "+30% de dano de fogo, raio e gelo" },
		{ Id = "LightFeet",   Name = "Pe Leve",        Stat = "MoveSpeed",      Value = 0.10, Desc = "+10% de velocidade" },
	},
}

----------------------------------------------------------------
-- ARTEFATOS (10, efeito permanente ao obter, nao resetam)
-- Chance de cair por inimigo morto; sorteia entre os que faltam.
----------------------------------------------------------------
Config.Artifacts = {
	DropChancePerKill = 0.005,  -- 0,5%
	Pool = {
		{ Id = "SlimeRing",     Name = "Anel de Slime",         Stat = "AuraRadius",      Value = 0.10, Desc = "+10% de raio da aura" },
		{ Id = "ZombieTooth",   Name = "Dente de Zumbi",        Stat = "AuraDamage",      Value = 0.10, Desc = "+10% de dano do tick" },
		{ Id = "CrackedSkull",  Name = "Cranio Rachado",        Stat = "DropAmount",      Value = 0.10, Desc = "+10% de drops" },
		{ Id = "EternalEmber",  Name = "Brasa Eterna",          Stat = "FireDamage",      Value = 0.20, Desc = "+20% de dano de fogo" },
		{ Id = "ThunderFeather",Name = "Pena do Trovao",        Stat = "LightningDamage", Value = 0.20, Desc = "+20% de dano de raio" },
		{ Id = "FrostCrystal",  Name = "Cristal Gelido",        Stat = "IceDamage",       Value = 0.20, Desc = "+20% de dano de gelo" },
		{ Id = "OldBoots",      Name = "Botas Velhas",          Stat = "MoveSpeed",       Value = 0.10, Desc = "+10% de velocidade" },
		{ Id = "RustyClock",    Name = "Relogio Enferrujado",   Stat = "RespawnTime",     Value = -0.10, Desc = "-10% no tempo de respawn" },
		{ Id = "BottomlessBag", Name = "Bolsa Sem Fundo",       Stat = "UpgradeCost",     Value = -0.05, Desc = "-5% no custo dos upgrades" },
		{ Id = "CollectorEye",  Name = "Olho do Colecionador",  Stat = "ArtifactChance",  Value = 0.50, Desc = "+50% de chance de artefato" },
	},
}

----------------------------------------------------------------
-- MULTIPLAYER E SALVAMENTO
----------------------------------------------------------------
Config.Multiplayer = {
	SharedEnemies = true,  -- inimigos pertencem ao servidor
	DropToKiller = true,   -- drop vai para quem deu o ultimo dano
	-- Dica: para o experimento, defina MaxPlayers = 1 nas configuracoes do jogo.
}

Config.Save = {
	Persist = { "Artifacts", "Talents", "ResetCount" },
	NotPersisted = { "Items", "Upgrades" },  -- progresso da run atual nao e salvo no MVP
}

----------------------------------------------------------------
-- FUNCOES AUXILIARES
----------------------------------------------------------------

-- Custo para comprar o nivel `level` (1..MaxLevel) de um upgrade.
-- Retorna tabela { Item = quantidade }.
function Config.CostAt(upgradeId, level)
	local up = Config.Upgrades[upgradeId] or Config.Speed
	local cost = {}
	for item, base in pairs(up.BaseCost) do
		cost[item] = round(base * up.CostGrowth ^ (level - 1))
	end
	return cost
end

-- Multiplicador de custo vindo de artefatos/talentos (bonus negativo reduz). Minimo 50%.
function Config.CostMultiplier(bonusSum)
	return math.max(0.5, 1 + bonusSum)
end

function Config.AuraRadius(level, bonusSum)
	return Config.Aura.BaseRadius * Config.Upgrades.AuraSize.ValueGrowth ^ level * (1 + (bonusSum or 0))
end

function Config.AuraDamage(bonusSum)
	return Config.Aura.BaseDamage * (1 + (bonusSum or 0))
end

function Config.TickInterval(level)
	return Config.Aura.BaseTickInterval * Config.Upgrades.TickSpeed.ValueGrowth ^ level
end

function Config.DropMultiplier(level, bonusSum)
	return Config.Upgrades.ExtraDrop.ValueGrowth ^ level * (1 + (bonusSum or 0))
end

function Config.WalkSpeed(level, bonusSum)
	local s = Config.Speed
	local speed = s.BaseWalkSpeed * (1 + s.PerLevel * level) * (1 + (bonusSum or 0))
	return math.min(speed, s.MaxWalkSpeed)
end

-- Requisito do proximo reinicio (resetCount = quantos reinicios ja foram feitos).
function Config.ResetRequirement(resetCount)
	local req = {}
	for item, base in pairs(Config.Reset.BaseRequirement) do
		req[item] = round(base * Config.Reset.Growth ^ resetCount)
	end
	return req
end

return Config
]]></ProtectedString>
