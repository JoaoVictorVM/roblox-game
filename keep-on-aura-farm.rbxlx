							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!strict
-- AuraVisual: anel do raio da aura (e do fogo), numeros de dano e efeitos de raio/gelo.
-- Dono: Agente UI. STUB da Fase 0 (contrato em docs/ARCHITECTURE.md).
-- Efeitos sao so locais (criados pelo cliente, nunca no Workspace do servidor).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Types = require(ReplicatedStorage.Shared.Types)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local AuraVisual = {}

function AuraVisual.Init(): ()
	-- TODO(UI): anel que segue o personagem; ouvir DamageDealt (numero de dano por Source,
	-- efeito de raio/gelo na Position, destaque quando Killed)
end

function AuraVisual.Update(snapshot: Types.ClientSnapshot): ()
	-- TODO(UI): raio do anel = snapshot.Stats.AuraRadius; anel de fogo se snapshot.Stats.FireLevel > 0
end

return AuraVisual
]]></ProtectedString>
							<string name="ScriptGuid">{971191C8-632D-4991-81FA-4AC959027692}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">AuraVisual</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">39c41e4c1cea6deb0ae9b4e4000007db</UniqueId>
						</Properties>
					</Item>
				</Item>
				<Item class="LocalScript" referent="RBX20CD405D55694BB6B7EF1BBF48FD75EE">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Client.Main: espera o Shared replicar, inicia os modulos de UI e distribui o snapshot do servidor.
-- Dono: lider. Os modulos de UI podem usar ReplicatedStorage.Shared.X direto: este script garante que ja existe.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

if not game:IsLoaded() then
	game.Loaded:Wait()
end
local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
for _, name in { "Config", "Types", "Remotes" } do
	sharedFolder:WaitForChild(name)
end

local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)

local UI = script.Parent.UI
local modules: { [string]: Types.UIModule } = {
	HUD = require(UI.HUD),
	UpgradeShop = require(UI.UpgradeShop),
	TalentChoice = require(UI.TalentChoice),
	ResetPanel = require(UI.ResetPanel),
	AuraVisual = require(UI.AuraVisual),
}

-- Um modulo com erro nao derruba os outros
for name, module in modules do
	local ok, err = pcall(module.Init)
	if not ok then
		warn("[Client] Init falhou em " .. name .. ": " .. tostring(err))
	end
end

local function dispatch(snapshot: Types.ClientSnapshot)
	for name, module in modules do
		local ok, err = pcall(module.Update, snapshot)
		if not ok then
			warn("[Client] Update falhou em " .. name .. ": " .. tostring(err))
		end
	end
end

Remotes.Event(Remotes.Names.StateUpdated).OnClientEvent:Connect(dispatch)

-- Estado inicial (nil se o servidor ainda nao carregou; nesse caso chega via StateUpdated)
task.spawn(function()
	local snapshot = Remotes.Function(Remotes.Names.RequestState):InvokeServer()
	if snapshot then
		dispatch(snapshot)
	end
end)
]]></ProtectedString>
